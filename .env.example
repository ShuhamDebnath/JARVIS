# ==============================================================================

# JARVIS ENVIRONMENT VARIABLES TEMPLATE

# ==============================================================================

# Instructions: Copy this file, rename it to .env, and fill in your actual keys.

# DO NOT commit the .env file to version control.

# ------------------------------------------------------------------------------

# PRIMARY LLM PROVIDERS

# ------------------------------------------------------------------------------

# P1.15: primary LLM is now the direct MiniMax API (MINIMAX_API_KEY).
# Cheaper + single-billing-source per the user's MiniMax token plan.
# DEEPSEEK/OPENROUTER below are kept as fallback (flip agents.yaml back
# to `deepseek/deepseek-chat` with a one-line `replace_all` if needed).

MINIMAX_API_KEY=your_minimax_api_key_here

# Optional — override the MiniMax API base URL. Defaults to
# https://api.minimax.chat/v1 (the public OpenAI-compatible
# endpoint). Set this if you self-host a MiniMax proxy, use a
# regional endpoint, or want to point at a staging URL.
# Consumed by backend/utils/llm_provider.py (P1.15 shim).
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# DeepSeek (Primary for reasoning, writing, orchestration)

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter (For MiniMax M3/M2.7 - Coding & Fallbacks)

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic (For Claude 3.5 Sonnet - Vision / UI Validation)

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------

# SEARCH & SCRAPING TOOLS

# ------------------------------------------------------------------------------

# SerperDev (Web search for agents - 2500 free queries/month)

SERPER_API_KEY=your_serper_api_key_here

# Firecrawl (Web scraper for JS-rendered sites)

FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------

# SKYVERN BROWSER AUTOMATION (Phase 3b)

# ------------------------------------------------------------------------------

# Skyvern Cloud API key — get one at https://skyvern.com
# If not set, SkyvernTool runs in logging-only fallback mode (graceful deg).

SKYVERN_BROWSER_API_KEY=your_skyvern_browser_api_key_here

# ------------------------------------------------------------------------------

# VOICE & AUTOMATION (PHASE 5)

# ------------------------------------------------------------------------------

# Picovoice Porcupine ("Hey Jarvis" Wake Word Detection)

PORCUPINE_ACCESS_KEY=your_picovoice_access_key_here